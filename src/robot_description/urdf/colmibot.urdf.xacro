<?xml version="1.0"?>
<!--
  Colmibot: robot movil diferencial (2 motorreductores Pololu 37D + 2 ruedas locas).

  Argumentos:
    use_meshes:=true   (por defecto) mallas STL exportadas del CAD (ver tools/prepare_meshes.py)
    use_meshes:=false  geometria simplificada (cajas/cilindros), no requiere mallas

  Arbol de frames:
    base_footprint -> base_link -> wheel_left_link / wheel_right_link
                                -> camera_link -> camera_optical_frame
                                -> imu_link
                                -> tof_left_link / tof_center_link / tof_right_link
-->
<robot name="colmibot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_meshes" default="true"/>
  <xacro:property name="use_meshes" value="$(arg use_meshes)"/>

  <xacro:include filename="$(find robot_description)/urdf/colmibot_params.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/macros.xacro"/>
  <!-- Masa, centro de masa e inercia del CAD (tools/compute_inertial.py + inertia/masas.csv) -->
  <xacro:include filename="$(find robot_description)/urdf/generated/colmibot_inertial.xacro"/>
  <xacro:if value="${use_meshes}">
    <!-- Sobrescribe medidas de colmibot_params.xacro y define body_mesh_links -->
    <xacro:include filename="$(find robot_description)/urdf/generated/colmibot_meshes.xacro"/>
  </xacro:if>

  <!-- ============ Base ============ -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:unless value="${use_meshes}">
      <visual>
        <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
        <geometry>
          <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
        </geometry>
        <material name="impreso_3d"/>
      </visual>
      <!-- Ruedas locas como esferas (fijas: no aportan a la cinematica) -->
      <visual>
        <origin xyz="${caster_x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="ruedas_locas"/>
      </visual>
      <visual>
        <origin xyz="${-caster_x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="ruedas_locas"/>
      </visual>
    </xacro:unless>

    <!-- Colisiones siempre simplificadas: mas ligeras para planeacion/simulacion -->
    <collision>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="${caster_x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <collision>
      <origin xyz="${-caster_x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>

    <!-- Incluye la masa de TODAS las piezas del CAD, aunque no tengan malla visual -->
    <xacro:base_inertial/>
  </link>

  <!-- Mallas del cuerpo: un link fijo por grupo para que RViz2 respete cada color -->
  <xacro:if value="${use_meshes}">
    <xacro:body_mesh_links parent="base_link"/>
  </xacro:if>

  <!-- ============ Ruedas motrices ============ -->
  <xacro:drive_wheel side="left" x="${wheel_left_x}" y="${wheel_left_y}" z="${wheel_left_z}"
                     use_meshes="${use_meshes}"/>
  <xacro:drive_wheel side="right" x="${wheel_right_x}" y="${wheel_right_y}" z="${wheel_right_z}"
                     use_meshes="${use_meshes}"/>

  <!-- ============ Sensores ============ -->
  <xacro:sensor_frame name="camera_link" parent="base_link"
                      x="${camera_x}" y="${camera_y}" z="${camera_z}" pitch="${camera_pitch}"/>
  <!-- Convencion optica: Z adelante, X derecha, Y abajo -->
  <xacro:sensor_frame name="camera_optical_frame" parent="camera_link"
                      x="0" y="0" z="0" roll="${-pi/2}" yaw="${-pi/2}"/>

  <xacro:sensor_frame name="imu_link" parent="base_link"
                      x="${imu_x}" y="${imu_y}" z="${imu_z}"/>

  <xacro:sensor_frame name="tof_left_link" parent="base_link"
                      x="${tof_left_x}" y="${tof_left_y}" z="${tof_left_z}" yaw="${tof_side_yaw}"/>
  <xacro:sensor_frame name="tof_center_link" parent="base_link"
                      x="${tof_center_x}" y="${tof_center_y}" z="${tof_center_z}"/>
  <xacro:sensor_frame name="tof_right_link" parent="base_link"
                      x="${tof_right_x}" y="${tof_right_y}" z="${tof_right_z}" yaw="${-tof_side_yaw}"/>

</robot>
