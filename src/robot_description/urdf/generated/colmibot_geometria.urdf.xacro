<?xml version="1.0"?>
<!-- ARCHIVO GENERADO - NO EDITAR A MANO -->
<!-- Lo escribe tools/generar_modelo.py desde el CAD y se sobrescribe. -->
<!-- Para cambiar geometria: mover la pieza en SolidWorks y regenerar.  -->
<!-- Para cambiar parametros: editar urdf/colmibot.urdf.xacro.          -->
<robot name="colmibot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="gris"><color rgba="0.75 0.75 0.78 1"/></material>
  <material name="oscuro"><color rgba="0.25 0.25 0.28 1"/></material>

  <!-- ===================== MARCO DE SUELO ========================== -->
  <link name="base_footprint"/>
  <joint name="joint_base_footprint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${altura_chasis}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== ESLABONES =============================== -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/base.stl"/>
      </geometry>
      <material name="gris"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.2 0.2 0.096"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.296546381"/>
      <inertia ixx="0.00110892242" ixy="-2.91306878e-06" ixz="2.44626152e-06" iyy="0.0011065976" iyz="8.2874306e-06" izz="0.00186395347"/>
