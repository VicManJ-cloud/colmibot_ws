<?xml version="1.0"?>
<!--
  Parametros del Colmibot (metros, radianes, kg).

  Convencion de ejes (REP-103): X adelante, Y izquierda, Z arriba.
  base_link esta en el punto medio del eje de las ruedas motrices.

  Las masas e inercias no estan aqui: salen del CAD en
  urdf/generated/colmibot_inertial.xacro (ver tools/compute_inertial.py).

  Los valores marcados con [CAD] son estimaciones para el modo simplificado
  (use_meshes:=false). Cuando se usan mallas, tools/prepare_meshes.py genera
  urdf/generated/colmibot_meshes.xacro y sobrescribe esas propiedades con
  valores medidos directamente del ensamble.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Ruedas motrices: llanta de 60 mm (CLM-Llanta60mmD) -->
  <xacro:property name="wheel_radius" value="0.030"/>        <!-- [CAD] -->
  <xacro:property name="wheel_width" value="0.026"/>         <!-- [CAD] -->
  <xacro:property name="wheel_left_x" value="0.0"/>
  <xacro:property name="wheel_left_y" value="0.095"/>        <!-- [CAD] -->
  <xacro:property name="wheel_left_z" value="0.0"/>
  <xacro:property name="wheel_right_x" value="0.0"/>
  <xacro:property name="wheel_right_y" value="-0.095"/>      <!-- [CAD] -->
  <xacro:property name="wheel_right_z" value="0.0"/>

  <!-- Cuerpo (modo simplificado) -->
  <xacro:property name="chassis_length" value="0.22"/>       <!-- [CAD] -->
  <xacro:property name="chassis_width" value="0.16"/>        <!-- [CAD] -->
  <xacro:property name="chassis_height" value="0.10"/>       <!-- [CAD] -->
  <xacro:property name="chassis_z" value="0.035"/>           <!-- [CAD] centro de la caja sobre el eje -->

  <!-- Ruedas locas (2x CLM-RuedaLoca), una adelante y una atras -->
  <xacro:property name="caster_radius" value="0.012"/>       <!-- [CAD] -->
  <xacro:property name="caster_x" value="0.085"/>            <!-- [CAD] -->

  <!-- Sensores -->
  <xacro:property name="camera_x" value="0.09"/>             <!-- [CAD] Logitech C920 -->
  <xacro:property name="camera_y" value="0.0"/>
  <xacro:property name="camera_z" value="0.14"/>
  <!-- Inclinacion hacia abajo de CLM-LogitechC920Montaj en el CAD: asin(0.10618) = 6.1 deg -->
  <xacro:property name="camera_pitch" value="0.1064"/>
  <xacro:property name="imu_x" value="0.0"/>                 <!-- [CAD] BMI270 -->
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="0.04"/>
  <!-- 3x VL53L1X en CLM-Holder3TOF -->
  <xacro:property name="tof_left_x" value="0.11"/>           <!-- [CAD] -->
  <xacro:property name="tof_left_y" value="0.035"/>
  <xacro:property name="tof_left_z" value="0.02"/>
  <xacro:property name="tof_center_x" value="0.115"/>
  <xacro:property name="tof_center_y" value="0.0"/>
  <xacro:property name="tof_center_z" value="0.02"/>
  <xacro:property name="tof_right_x" value="0.11"/>
  <xacro:property name="tof_right_y" value="-0.035"/>
  <xacro:property name="tof_right_z" value="0.02"/>
  <xacro:property name="tof_side_yaw" value="0.5236"/>       <!-- 30 deg: rotacion exacta de VL53L1XV2-2/-3 en el CAD -->

</robot>
